# Токен вашего Telegram бота (получите у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Битрейт аудио по умолчанию (кбит/с: 128, 192, 256, 320)
AUDIO_BITRATE=192

# (Опционально) Если провайдер блокирует api.telegram.org, укажите ваш VPN/прокси:
# PROXY=http://127.0.0.1:10809
# PROXY=socks5://127.0.0.1:10808

# (Опционально) Зеркало или собственный Cloudflare Worker обратный прокси:
# CUSTOM_API_SERVER=https://my-tg-proxy.workers.dev

