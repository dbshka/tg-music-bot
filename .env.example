# ==============================================================================
# Telegram Music Bot — Конфигурация окружения (.env)
# Скопируйте этот файл в .env и укажите ваши параметры: cp .env.example .env
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram бота (получите у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# [ОПЦИОНАЛЬНО] Битрейт аудио по умолчанию при конвертации (кбит/с: 128, 192, 256, 320)
AUDIO_BITRATE=192

# [ОПЦИОНАЛЬНО] Telegram User ID администратора (для команд /stats и /broadcast)
ADMIN_ID=

# [ОПЦИОНАЛЬНО] Порт встроенного HTTP healthcheck-сервера (по умолчанию 7860)
PORT=7860

# [ОПЦИОНАЛЬНО] Путь к файлу базы данных SQLite (по умолчанию bot_database.db)
DB_PATH=bot_database.db

# ------------------------------------------------------------------------------
# Прокси и сетевая маршрутизация
# ------------------------------------------------------------------------------

# Общий прокси для подключения бота к api.telegram.org (HTTP / SOCKS5):
# PROXY=http://127.0.0.1:10809
# PROXY=socks5://127.0.0.1:10808

# Отдельный прокси для загрузки с YouTube и зарубежных платформ:
# YOUTUBE_PROXY=socks5://127.0.0.1:10808

# Российский прокси для региональных платформ (Яндекс Музыка, ВКонтакте):
# RUSSIAN_PROXY=http://user:pass@ru-proxy.example.com:8080

# VLESS-ссылка или URL подписки для автоматического запуска SOCKS5 через sing-box:
# VLESS_URL=vless://uuid@server.example.com:443?security=reality&sni=example.com&fp=chrome&pbk=publicKey&sid=shortId#Foreign
# VLESS_RU_URL=vless://uuid@ru-server.example.com:443?security=reality&sni=example.ru&fp=chrome&pbk=publicKey&sid=shortId#Russian

# ------------------------------------------------------------------------------
# Авторизационные токены стриминговых сервисов (опционально)
# ------------------------------------------------------------------------------

# OAuth-токен Яндекс Музыки (для треков в высоком качестве):
# YANDEX_MUSIC_TOKEN=y0_AgAAAA...

# Токен авторизации ВКонтакте (для закрытых аудиозаписей):
# VK_TOKEN=vk1.a....

# Зеркало или локальный сервер Telegram Bot API:
# CUSTOM_API_SERVER=https://my-tg-proxy.workers.dev
